# Copy to .env and fill in. Never commit .env.
TINYFISH_API_KEY=

# Required in production: TinyFish Monitor webhook secret.
# TinyFish does not sign scheduled Monitor webhooks, so the Watch API puts this
# token in the webhook URL (?token=...). Requests may alternatively carry an
# HMAC of "<timestamp>.<raw body>" in X-TinyFish-Signature with
# X-TinyFish-Timestamp (±300s). Request logs record only the pathname.
TINYVERIFY_WEBHOOK_SECRET=

# Optional: admin key for listing every watch across browsers and for
# cache-bypassing refresh reads. Sent as X-Tinyverify-Admin.
TINYVERIFY_ADMIN_KEY=

# Optional demo affordances: when 1, /api/health reports demo=true and the UI
# shows a clearly labelled "Simulate change (demo)" button. Simulated events
# never change the live snapshot.
TINYVERIFY_DEMO=0

# Optional: default schedule for new monitors (five-field cron, UTC)
TINYVERIFY_MONITOR_CRON=0 8 * * *

# Optional: canonical public HTTPS origin used for TinyFish Monitor webhooks.
# Never derived from the request Host header.
# TINYVERIFY_PUBLIC_URL=https://tinyverify.vercel.app

# Optional: override local data directory
# TINYVERIFY_DATA_DIR=./data

# Optional: paid-agent guards (CSLB fallback)
# TINYVERIFY_ALLOW_AGENT=true
# TINYVERIFY_AGENT_RUNS_PER_HOUR=3
# TINYVERIFY_AGENT_CONCURRENCY=2
# TINYVERIFY_CSLB_AGENT_SECONDS=150

# Optional: trust X-Real-IP / X-Forwarded-For for rate limiting. Vercel is
# trusted automatically; set to 1 only behind your own reverse proxy.
# TRUST_PROXY=0

# Optional: Vercel KV / Upstash Redis REST (persists monitors in production)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
